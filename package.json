  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "typescript": "^5.8.0",
    "vitest": "^5.0.2"
  }
