# Copiar a pruebas-carga/.env.staging (esta en .gitignore) y rellenar con STAGING.
# Nunca poner aqui la service_role: esa va solo en el entorno de la ventana
# ($env:SUPABASE_SERVICE_ROLE) mientras corre la prueba.

# Proyecto satag-staging (Settings -> API). Ambas viajan al navegador; identifican a staging.
SUPABASE_URL=https://<ref-de-staging>.supabase.co
SUPABASE_KEY=sb_publishable_...

# Opcional: URL del preview de Vercel (o del subdominio) apuntando a staging.
# Si viene, cada familia pide tambien el HTML de /registro/ (mide el front).
FRONT_URL=

# Cuenta de STAGING con rol super (satag.super@example.com segun supabase/staging/README.md).
# Debe tener TOTP enrolado; el secreto base32 es el que muestra el QR al enrolar
# (SignaturePad -> GateMfa -> "secreto en texto"). Guardarlo tambien en el gestor.
PANEL_EMAIL=satag.super@example.com
PANEL_PASSWORD=
PANEL_TOTP_SECRET=

# Limite de conexiones directas del proyecto (Settings -> Infrastructure). Nano: 60.
LIMITE_CONEXIONES=60
